        "import glob, os, re, unicodedata\n",
        "import numpy as np, pandas as pd\n",
        "\n",
        "DADOS = f\"{BASE}/dados_tratados\"\n",
        "os.makedirs(DADOS, exist_ok=True)\n",
        "\n",
        "def consolidar(pasta_mensal, prefixo, esperado=21):\n",
        "    arqs = sorted(glob.glob(f\"{pasta_mensal}/{prefixo}_*.parquet\"))\n",
        "    assert len(arqs) == esperado, f\"{prefixo}: {len(arqs)} arquivos (esperado {esperado})\"\n",
        "    df = pd.concat((pd.read_parquet(a) for a in arqs), ignore_index=True)\n",
        "    df[\"data_competencia\"] = pd.to_datetime(df[\"competencia\"].astype(str), format=\"%Y%m\")\n",
        "    return df\n",
        "\n",
        "fato = consolidar(PASTA_MENSAL, \"fato\")\n",
        "ocup = consolidar(PASTA_MENSAL, \"ocup\")\n",
        "\n",
        "# Conferências\n",
        "print(\"fato:\", fato.shape, \"| ocup:\", ocup.shape)\n",
        "print(\"competências distintas:\", fato.competencia.nunique(), ocup.competencia.nunique())\n",
        "chaves = [\"competencia\",\"uf\",\"secao\",\"escolaridade_cod\",\"sexo_cod\",\"faixa_etaria\"]\n",
        "print(\"chaves duplicadas no fato:\", fato.duplicated(chaves).sum())\n",
        "m = fato.groupby(\"competencia\")[[\"admissoes\",\"desligamentos\"]].sum()\n",
        "m[\"saldo\"] = m.admissoes - m.desligamentos\n",
        "m2 = ocup.groupby(\"competencia\")[[\"admissoes\",\"desligamentos\"]].sum()\n",
        "print(\"fato = ocup em admissões/desligamentos?\", m[[\"admissoes\",\"desligamentos\"]].equals(m2))\n",
        "print(m.map(lambda v: f\"{v:,.0f}\".replace(\",\", \".\")))\n",
        "\n",
        "fato.to_parquet(f\"{DADOS}/fato_emprego.parquet\", index=False)\n",
        "ocup.to_parquet(f\"{DADOS}/fato_ocupacao.parquet\", index=False)\n",
        "for n in [\"fato_emprego\",\"fato_ocupacao\"]:\n",
        "    print(n, round(os.path.getsize(f\"{DADOS}/{n}.parquet\")/1e6, 1), \"MB\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
