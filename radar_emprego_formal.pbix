        "novas = pd.DataFrame({\"familia\": faltam})\n",
        "novas[\"exemplos\"] = \"Família ausente do layout oficial do Novo CAGED\"\n",
        "novas[\"familia_4d\"] = novas.familia.astype(str).str.zfill(4)\n",
        "novas[\"grande_grupo\"] = (novas.familia // 1000).astype(str).map(GRANDE_GRUPO)\n",
        "novas[\"ti_dados\"] = False\n",
        "novas[\"segmento\"] = \"Demais ocupações\"\n",
        "\n",
        "fam = pd.concat([fam, novas], ignore_index=True).sort_values(\"familia\")\n",
        "fam.to_csv(f\"{DADOS}/dim_cbo_familia.csv\", index=False, encoding=\"utf-8-sig\")\n",
        "\n",
        "print(len(fam), \"famílias\")\n",
