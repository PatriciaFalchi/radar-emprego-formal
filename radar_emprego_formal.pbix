        "!pip -q install py7zr"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import ftplib, os\n",
        "\n",
        "HOST = \"ftp.mtps.gov.br\"\n",
        "ANO, MES = 2025, 1\n",
        "comp = f\"{ANO}{MES:02d}\"\n",
        "pasta = f\"/pdet/microdados/NOVO CAGED/{ANO}/{comp}\"\n",
        "arq = f\"CAGEDMOV{comp}.7z\"\n",
        "\n",
        "os.makedirs(\"dados_brutos\", exist_ok=True)\n",
        "ftp = ftplib.FTP(HOST, timeout=120)\n",
        "ftp.login()\n",
        "ftp.cwd(pasta)\n",
        "print(ftp.nlst())\n",
        "with open(f\"dados_brutos/{arq}\", \"wb\") as f:\n",
        "    ftp.retrbinary(f\"RETR {arq}\", f.write)\n",
        "ftp.quit()\n",
        "print(\"baixado:\", os.path.getsize(f\"dados_brutos/{arq}\") / 1e6, \"MB\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "JAvFAa-2lSd1",
        "outputId": "9890e97a-0352-4545-d364-8c2c4e89a784"
      },
      "execution_count": 3,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "['CAGEDEXC202501.7z', 'CAGEDFOR202501.7z', 'CAGEDMOV202501.7z']\n",
            "baixado: 55.719173 MB\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import py7zr, pandas as pd\n",
        "\n",
        "with py7zr.SevenZipFile(f\"dados_brutos/{arq}\") as z:\n",
        "    z.extractall(\"dados_brutos\")\n",
        "print(os.listdir(\"dados_brutos\"))\n",
        "\n",
        "df = pd.read_csv(f\"dados_brutos/CAGEDMOV{comp}.txt\",\n",
        "                 sep=\";\", decimal=\",\", encoding=\"utf-8\", nrows=100_000)\n",
        "print(df.shape)\n",
        "display(df.head())\n",
        "df.info()"
      ],
      "metadata": {
