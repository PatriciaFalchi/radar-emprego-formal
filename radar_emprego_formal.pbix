    {
      "cell_type": "code",
      "source": [
        "from google.colab import drive\n",
        "drive.mount(\"/content/drive\")\n",
        "\n",
        "import ftplib, os, time, unicodedata\n",
        "import pandas as pd, numpy as np, py7zr\n",
        "\n",
        "BASE = \"/content/drive/MyDrive/radar_emprego_formal\"\n",
        "PASTA_MENSAL = f\"{BASE}/mensal\"\n",
        "os.makedirs(PASTA_MENSAL, exist_ok=True)\n",
        "os.makedirs(\"bruto\", exist_ok=True)\n",
        "\n",
        "HOST = \"ftp.mtps.gov.br\"\n",
        "RAIZ = \"/pdet/microdados/NOVO CAGED\"\n",
        "\n",
        "# regras de tratamento do salário (vão para o README)\n",
        "UNIDADE_MENSAL = 5\n",
        "SAL_MIN, SAL_MAX = 500, 100_000\n",
        "\n",
        "# jan/2025 a set/2026\n",
        "MESES = [(2025, m) for m in range(1, 13)] + [(2026, m) for m in range(1, 10)]\n",
        "\n",
        "def norm(c):\n",
        "    return unicodedata.normalize(\"NFKD\", c).encode(\"ascii\", \"ignore\").decode().lower().strip()\n",
        "\n",
        "COLUNAS = [\"competenciamov\", \"uf\", \"secao\", \"saldomovimentacao\", \"graudeinstrucao\",\n",
        "           \"idade\", \"sexo\", \"salario\", \"unidadesalariocodigo\", \"cbo2002ocupacao\"]\n",
        "\n",
        "BINS_IDADE = [-np.inf, 17, 24, 29, 39, 49, 64, np.inf]\n",
        "ROTULOS_IDADE = [\"Até 17\", \"18 a 24\", \"25 a 29\", \"30 a 39\", \"40 a 49\", \"50 a 64\", \"65 ou mais\"]"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "wrTI7JoCpMn7",
        "outputId": "18ee68a3-2d0d-4301-8117-013f317bd6cc"
      },
      "execution_count": 11,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Mounted at /content/drive\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def agregar(caminho_txt):\n",
        "    df = pd.read_csv(caminho_txt, sep=\";\", decimal=\",\", encoding=\"utf-8\",\n",
        "                     usecols=lambda c: norm(c) in COLUNAS)\n",
        "    df.columns = [norm(c) for c in df.columns]\n",
        "    faltando = set(COLUNAS) - set(df.columns)\n",
        "    assert not faltando, f\"colunas ausentes: {faltando}\"\n",
        "\n",
        "    df[\"adm\"] = (df[\"saldomovimentacao\"] == 1).astype(\"int8\")\n",
        "    df[\"des\"] = (df[\"saldomovimentacao\"] == -1).astype(\"int8\")\n",
        "    valido = ((df[\"adm\"] == 1)\n",
        "              & (df[\"unidadesalariocodigo\"] == UNIDADE_MENSAL)\n",
        "              & df[\"salario\"].between(SAL_MIN, SAL_MAX))\n",
        "    df[\"n_sal\"] = valido.astype(\"int8\")\n",
        "    df[\"soma_sal\"] = df[\"salario\"].where(valido, 0.0)\n",
        "\n",
        "    faixa = pd.cut(df[\"idade\"], bins=BINS_IDADE, labels=ROTULOS_IDADE)\n",
        "    df[\"faixa_etaria\"] = faixa.astype(object).fillna(\"Não informada\")\n",
        "    df[\"cbo_familia\"] = df[\"cbo2002ocupacao\"] // 100\n",
        "\n",
        "    medidas = [\"adm\", \"des\", \"n_sal\", \"soma_sal\"]\n",
        "    novos_nomes = {\"adm\": \"admissoes\", \"des\": \"desligamentos\",\n",
        "                   \"n_sal\": \"n_salarios\", \"soma_sal\": \"soma_salarios\",\n",
        "                   \"competenciamov\": \"competencia\", \"graudeinstrucao\": \"escolaridade_cod\",\n",
        "                   \"sexo\": \"sexo_cod\"}\n",
        "\n",
        "    fato = (df.groupby([\"competenciamov\", \"uf\", \"secao\", \"graudeinstrucao\", \"sexo\", \"faixa_etaria\"],\n",
        "                       observed=True)[medidas].sum().reset_index().rename(columns=novos_nomes))\n",
        "    ocup = (df.groupby([\"competenciamov\", \"uf\", \"cbo_familia\"],\n",
        "                       observed=True)[medidas].sum().reset_index().rename(columns=novos_nomes))\n",
        "\n",
        "    resumo = {\n",
        "        \"linhas\": len(df),\n",
        "        \"competencias\": sorted(df[\"competenciamov\"].unique().tolist()),\n",
        "        \"admissoes\": int(df[\"adm\"].sum()),\n",
        "        \"desligamentos\": int(df[\"des\"].sum()),\n",
        "        \"pct_adm_com_salario_valido\": round(100 * df[\"n_sal\"].sum() / max(df[\"adm\"].sum(), 1), 1),\n",
        "        \"linhas_fato\": len(fato),\n",
        "        \"linhas_ocupacao\": len(ocup),\n",
        "    }\n",
        "    return fato, ocup, resumo\n",
        "\n",
        "\n",
        "def baixar(comp, destino, tentativas=3):\n",
        "    ano = comp[:4]\n",
        "    arq = f\"CAGEDMOV{comp}.7z\"\n",
        "    for t in range(1, tentativas + 1):\n",
        "        try:\n",
        "            ftp = ftplib.FTP(HOST, timeout=300)\n",
        "            ftp.encoding = \"latin-1\"\n",
        "            ftp.login()\n",
        "            ftp.cwd(f\"{RAIZ}/{ano}/{comp}\")\n",
        "            with open(destino, \"wb\") as f:\n",
        "                ftp.retrbinary(f\"RETR {arq}\", f.write)\n",
        "            ftp.quit()\n",
        "            return\n",
        "        except Exception as e:\n",
        "            print(f\"   tentativa {t} falhou: {e}\")\n",
        "            time.sleep(5)\n",
        "    raise RuntimeError(f\"não consegui baixar {arq}\")\n",
        "\n",
        "\n",
        "def processar_mes(ano, mes, forcar=False):\n",
        "    comp = f\"{ano}{mes:02d}\"\n",
        "    f_fato = f\"{PASTA_MENSAL}/fato_{comp}.parquet\"\n",
        "    f_ocup = f\"{PASTA_MENSAL}/ocup_{comp}.parquet\"\n",
        "    if os.path.exists(f_fato) and os.path.exists(f_ocup) and not forcar:\n",
        "        print(f\"{comp}: já processado, pulando\")\n",
        "        return\n",
        "    t0 = time.time()\n",
        "    arq7z = f\"bruto/CAGEDMOV{comp}.7z\"\n",
        "    txt = f\"bruto/CAGEDMOV{comp}.txt\"\n",
        "    baixar(comp, arq7z)\n",
        "    with py7zr.SevenZipFile(arq7z) as z:\n",
        "        z.extractall(\"bruto\")\n",
        "    fato, ocup, r = agregar(txt)\n",
        "    fato.to_parquet(f_fato, index=False)\n",
        "    ocup.to_parquet(f_ocup, index=False)\n",
        "    os.remove(arq7z)\n",
        "    os.remove(txt)\n",
        "    aviso = \"\" if r[\"competencias\"] == [int(comp)] else f\"  ATENÇÃO competências no arquivo: {r['competencias']}\"\n",
        "    print(f\"{comp}: {r['linhas']:,} linhas | adm {r['admissoes']:,} | des {r['desligamentos']:,} \"\n",
        "          f\"| saldo {r['admissoes'] - r['desligamentos']:,} | salário válido {r['pct_adm_com_salario_valido']}% \"\n",
        "          f\"| fato {r['linhas_fato']:,} linhas | {time.time() - t0:.0f}s{aviso}\")"
      ],
      "metadata": {
        "id": "orLwdOURqQVe"
      },
      "execution_count": 13,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "processar_mes(2025, 1)\n",
        "\n",
        "f = pd.read_parquet(f\"{PASTA_MENSAL}/fato_202501.parquet\")\n",
        "display(f.head())\n",
        "print(f.shape)\n",
        "print(f[[\"admissoes\", \"desligamentos\", \"n_salarios\"]].sum())\n",
        "print(\"salário médio de admissão (regra aprovada): R$\",\n",
        "      round(f[\"soma_salarios\"].sum() / f[\"n_salarios\"].sum(), 2))"
      ],
