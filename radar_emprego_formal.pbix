      "cell_type": "code",
      "source": [
        "def norm(s):\n",
        "    s = unicodedata.normalize(\"NFKD\", str(s)).encode(\"ascii\", \"ignore\").decode()\n",
        "    return re.sub(r\"[^a-z0-9]\", \"\", s.lower())\n",
        "\n",
        "def ler_aba(xls, nome_norm):\n",
        "    aba = next(s for s in xls.sheet_names if norm(s) == nome_norm)\n",
        "    bruto = xls.parse(aba, header=None, dtype=str)\n",
        "    lin = next(i for i in range(len(bruto)) if norm(bruto.iloc[i, 0]) == \"codigo\")\n",
        "    d = bruto.iloc[lin + 1:, :2].dropna(how=\"all\").copy()\n",
        "    d.columns = [\"codigo\", \"descricao\"]\n",
        "    d[\"codigo\"] = d[\"codigo\"].str.strip()\n",
        "    d[\"descricao\"] = d[\"descricao\"].str.strip()\n",
        "    return d.reset_index(drop=True)\n",
        "\n",
        "SIGLA = {11:\"RO\",12:\"AC\",13:\"AM\",14:\"RR\",15:\"PA\",16:\"AP\",17:\"TO\",21:\"MA\",22:\"PI\",23:\"CE\",24:\"RN\",25:\"PB\",\n",
        "         26:\"PE\",27:\"AL\",28:\"SE\",29:\"BA\",31:\"MG\",32:\"ES\",33:\"RJ\",35:\"SP\",41:\"PR\",42:\"SC\",43:\"RS\",\n",
        "         50:\"MS\",51:\"MT\",52:\"GO\",53:\"DF\"}\n",
        "def regiao(c):\n",
        "    return (\"Norte\" if 11<=c<=17 else \"Nordeste\" if 21<=c<=29 else \"Sudeste\" if 31<=c<=35\n",
        "            else \"Sul\" if 41<=c<=43 else \"Centro-Oeste\" if 50<=c<=53 else \"Não identificado\")\n",
        "\n",
        "SECAO_CURTO = {\"A\":\"Agropecuária\",\"B\":\"Indústrias extrativas\",\"C\":\"Indústrias de transformação\",\n",
        " \"D\":\"Eletricidade e gás\",\"E\":\"Água, esgoto e resíduos\",\"F\":\"Construção\",\"G\":\"Comércio\",\n",
        " \"H\":\"Transporte e armazenagem\",\"I\":\"Alojamento e alimentação\",\"J\":\"Informação e comunicação\",\n",
        " \"K\":\"Finanças e seguros\",\"L\":\"Atividades imobiliárias\",\"M\":\"Atividades profissionais e científicas\",\n",
        " \"N\":\"Atividades administrativas\",\"O\":\"Administração pública\",\"P\":\"Educação\",\"Q\":\"Saúde e serviço social\",\n",
        " \"R\":\"Artes, cultura e esporte\",\"S\":\"Outros serviços\",\"T\":\"Serviços domésticos\",\"U\":\"Organismos internacionais\"}\n",
        "\n",
        "GRUPO_ESC = {1:(\"Fundamental incompleto\",1),2:(\"Fundamental incompleto\",1),3:(\"Fundamental incompleto\",1),\n",
        " 4:(\"Fundamental incompleto\",1),5:(\"Fundamental completo\",2),6:(\"Médio incompleto\",3),7:(\"Médio completo\",4),\n",
        " 8:(\"Superior incompleto\",5),9:(\"Superior completo\",6),10:(\"Pós-graduação\",7),11:(\"Pós-graduação\",7),\n",
        " 80:(\"Pós-graduação\",7),99:(\"Não informado\",8)}\n",
        "\n",
        "GRANDE_GRUPO = {\"0\":\"Forças armadas\",\"1\":\"Dirigentes e gerentes\",\"2\":\"Profissionais das ciências e das artes\",\n",
        " \"3\":\"Técnicos de nível médio\",\"4\":\"Serviços administrativos\",\"5\":\"Serviços e comércio\",\n",
        " \"6\":\"Agropecuária e pesca\",\"7\":\"Produção industrial\",\"8\":\"Produção industrial\",\"9\":\"Manutenção e reparação\"}\n",
        "\n",
        "KEYWORDS_TI = [\"sistemascomputacionais\",\"informatica\",\"tecnologiadainformacao\",\"computacao\",\"programador\",\n",
        " \"desenvolvedor\",\"bancodedados\",\"segurancadainformacao\",\"redesdecomputadores\",\"analistadesistemas\",\n",
        " \"cientistadedados\",\"analistadedados\",\"desenvolvimentodesistemas\",\"sistemasdeinformacao\"]\n",
        "\n",
        "def montar_dimensoes(xls, saida):\n",
        "    os.makedirs(saida, exist_ok=True)\n",
        "    w = lambda d, n: d.to_csv(f\"{saida}/{n}.csv\", index=False, encoding=\"utf-8-sig\")\n",
        "    uf = ler_aba(xls, \"uf\").rename(columns={\"codigo\":\"uf_cod\",\"descricao\":\"uf_nome\"})\n",
        "    uf[\"uf_cod\"] = uf[\"uf_cod\"].astype(int)\n",
        "    uf[\"uf_sigla\"] = uf[\"uf_cod\"].map(SIGLA).fillna(\"NI\"); uf[\"regiao\"] = uf[\"uf_cod\"].map(regiao)\n",
        "    w(uf, \"dim_uf\")\n",
        "    sec = ler_aba(xls, \"secao\").rename(columns={\"codigo\":\"secao\",\"descricao\":\"secao_oficial\"})\n",
        "    sec[\"secao_oficial\"] = sec[\"secao_oficial\"].str.replace(\"AqÜIcultura\",\"Aquicultura\", regex=False)\n",
        "    sec[\"setor\"] = sec[\"secao\"].map(SECAO_CURTO).fillna(sec[\"secao_oficial\"]); w(sec, \"dim_secao\")\n",
        "    esc = ler_aba(xls, \"graudeinstrucao\").rename(columns={\"codigo\":\"escolaridade_cod\",\"descricao\":\"escolaridade\"})\n",
        "    esc[\"escolaridade_cod\"] = esc[\"escolaridade_cod\"].astype(int)\n",
        "    esc[\"grupo_escolaridade\"] = esc[\"escolaridade_cod\"].map(lambda c: GRUPO_ESC[c][0])\n",
        "    esc[\"ordem_grupo\"] = esc[\"escolaridade_cod\"].map(lambda c: GRUPO_ESC[c][1]); w(esc, \"dim_escolaridade\")\n",
        "    sx = ler_aba(xls, \"sexo\").rename(columns={\"codigo\":\"sexo_cod\",\"descricao\":\"sexo\"})\n",
        "    sx[\"sexo_cod\"] = sx[\"sexo_cod\"].astype(int); w(sx, \"dim_sexo\")\n",
        "    rot = [\"Até 17\",\"18 a 24\",\"25 a 29\",\"30 a 39\",\"40 a 49\",\"50 a 64\",\"65 ou mais\",\"Não informada\"]\n",
        "    w(pd.DataFrame({\"faixa_etaria\":rot,\"ordem\":range(1,9)}), \"dim_faixa_etaria\")\n",
        "    cbo = ler_aba(xls, \"cbo2002ocupacao\").rename(columns={\"codigo\":\"cbo\",\"descricao\":\"ocupacao\"})\n",
        "    cbo[\"cbo\"] = cbo[\"cbo\"].astype(int); cbo[\"familia\"] = cbo[\"cbo\"] // 100\n",
        "    cbo[\"match_ti\"] = cbo[\"ocupacao\"].map(lambda t: any(k in norm(t) for k in KEYWORDS_TI))\n",
        "    fam = cbo.groupby(\"familia\").agg(exemplos=(\"ocupacao\", lambda s: \" | \".join(s.head(3))),\n",
        "                                      ti_dados_sugerido=(\"match_ti\",\"any\")).reset_index()\n",
        "    fam[\"grande_grupo\"] = fam[\"familia\"].astype(str).str[0].map(GRANDE_GRUPO)\n",
        "    w(fam, \"dim_cbo_familia\")\n",
        "    return uf, sec, esc, sx, fam\n",
        "\n",
        "xls = pd.ExcelFile(\"dados_brutos/layout_novo_caged.xlsx\")\n",
        "uf, sec, esc, sx, fam = montar_dimensoes(xls, DADOS)\n",
        "\n",
        "# Conferir se todos os códigos do fato existem nas dimensões\n",
        "print(\"UF sem dimensão:\", set(fato.uf) - set(uf.uf_cod))\n",
        "print(\"Seção sem dimensão:\", set(fato.secao) - set(sec.secao))\n",
        "print(\"Escolaridade sem dimensão:\", set(fato.escolaridade_cod) - set(esc.escolaridade_cod))\n",
        "print(\"Sexo sem dimensão:\", set(fato.sexo_cod) - set(sx.sexo_cod))\n",
        "print(\"Famílias CBO sem dimensão:\", len(set(ocup.cbo_familia) - set(fam.familia)))\n",
        "\n",
        "# Revisão da marcação \"TI e dados\"\n",
        "print(\"\\nFamílias marcadas como TI/dados (para revisar):\")\n",
        "print(fam[fam.ti_dados_sugerido][[\"familia\",\"exemplos\"]].to_string(index=False))\n",
        "print(sorted(os.listdir(DADOS)))"
      ],
      "metadata": {
